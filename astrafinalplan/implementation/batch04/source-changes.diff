+      !nonempty(a.role) ||
+      !JOB_STAGES.includes(a.stage) ||
+      !date(a.appliedDate) ||
+      !["remote", "hybrid", "onsite", "unknown"].includes(a.workMode) ||
+      !stamp(a.createdAt) ||
