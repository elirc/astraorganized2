+    [query.search, query.status].some(
+      (value) =>
+        value !== undefined &&
+        (typeof value !== "string" || value.length > 255),
+    )
+  )
+    throw new ValidationError("Filters must be short text values.");
+  return model.listRecords(query as { search?: string; status?: string });
+}
