+    ![0, 1].includes(s.weekStartsOn) ||
+    !["month", "week", "day", "agenda"].includes(s.defaultView) ||
+    !integer(s.dayStartHour, 0, 23) ||
+    !integer(s.dayEndHour, 1, 24) ||
+    s.dayEndHour <= s.dayStartHour ||
+    !integer(s.dailyGoal, 1) ||
+    !integer(s.stalePeriodDays, 1) ||
+    !text(s.displayName) ||
+    ["use24Hour", "autoScheduleInterviews", "showWeekNumbers"].some(
+      (k) => typeof s[k] !== "boolean",
+    )
+  )
+    return "Invalid backup settings.";
+  if (!stamp(value.exportedAt)) return "Invalid export timestamp.";
+  for (const [name, rows] of [
+    ["categories", categories],
+    ["events", events],
+    ["applications", applications],
+  ] as const)
+    if (!Array.isArray(rows) || rows.length > 100000 || !unique(rows))
+      return `Invalid or duplicate ${name} IDs.`;
